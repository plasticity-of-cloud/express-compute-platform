# k3s-Xpress component versions (sourced by install-k3s.sh)
# Aligned with EKS-D version matrix — both 1.35 and 1.36 supported.
# Set K3S_KUBERNETES_VERSION=1.35 or 1.36 at build time.

# ── k3s versions per Kubernetes track ──────────────────────────────────────────
# These are resolved at build time based on K3S_KUBERNETES_VERSION
K3S_VERSION_135="v1.35.7+k3s1"
K3S_VERSION_136="v1.36.3+k3s1"

# ── Add-ons ────────────────────────────────────────────────────────────────────
CERT_MANAGER_VERSION="v1.20.2"
CLOUDWATCH_AGENT_VERSION="v1.300048.1"

# ── ECP components ─────────────────────────────────────────────────────────────
ECP_CONTROL_PLANE_VERSION="1.1.6"
INSTALL_ECP=true
ECP_GHCR_REGISTRY="ghcr.io/codriverlabs"

# ── Tools ──────────────────────────────────────────────────────────────────────
SYFT_VERSION="1.22.0"

# ── k3s server config ──────────────────────────────────────────────────────────
# Disable bundled components we don't need on AWS
K3S_DISABLE="traefik,servicelb"
